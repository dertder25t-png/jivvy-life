{
  "manifest_version": 2,
  "name": "Lifeboard",
  "version": "0.4.0",
  "description": "A new tab and home page with one box that routes what you type to Google, an AI app, or Claude Code.",
  "browser_specific_settings": {
    "gecko": {
      "id": "hub-dashboard@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "chrome_settings_overrides": { "homepage": "newtab.html?home=1" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "permissions": ["storage", "nativeMessaging", "clipboardWrite", "history", "downloads", "alarms", "http://127.0.0.1/*"],
  "background": { "scripts": ["background.js"], "type": "module" },
  "browser_action": { "default_icon": "icon.svg", "default_title": "Lifeboard" },
  "icons": { "48": "icon.svg", "96": "icon.svg" }
}
