{
  "name": "jivvy-life",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:install": "bash scripts/install.sh",
    "electron:typecheck": "tsc -p electron",
    "electron:compile": "npm run electron:typecheck && node scripts/build-electron.mjs",
    "electron:build": "npm run build && npm run electron:compile",
    "electron:start": "electron --ozone-platform-hint=auto --enable-features=WaylandWindowDecorations .",
    "electron:dev": "node scripts/build-electron.mjs && node scripts/electron-dev.mjs",
    "electron:selftest": "JIVVY_SELFTEST=1 electron --ozone-platform-hint=auto --enable-features=WaylandWindowDecorations . --user-data-dir=${JIVVY_TEST_PROFILE:-/tmp/jivvy-selftest-profile}"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "^2.3.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@uiw/react-codemirror": "^4.23.10",
    "jszip": "^3.10.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.12.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "45.4.1",
    "esbuild": "0.25.12",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "main": "dist-electron/main.js"
}
