#!/usr/bin/python3 -I
"""Lifeboard next move: the Meta+Shift+. shortcut.

Reads $XDG_RUNTIME_DIR/hub-dashboard/next_move.json (written by hub_helper's "stage")
and opens its web address, but only if it hasn't expired, is http(s), and its confidence
is at or above its threshold. File moves never fire from here. Each firing is appended to
fired.jsonl next to it, so the dashboard can count it as a "fired" label, and the staged
move is used up. Otherwise it does nothing.

  lifeboard-next [--dry-run]    --dry-run prints the decision and opens nothing
"""
import json
import os
import subprocess
import sys
import time
from pathlib import Path


def runtime_dir():
    # Same rule as hub_helper.runtime_dir(): never /tmp, skip a snap's private runtime dir.
    base = os.environ.get("XDG_RUNTIME_DIR")
    if base and os.path.basename(base.rstrip("/")).startswith("snap."):
        base = os.path.dirname(base.rstrip("/"))
    if not base or not os.path.isdir(base):
        return Path.home() / ".local/state/hub-dashboard"
    return Path(base) / "hub-dashboard"


def decide(path, now_ms):
    """(fire?, why, move) for the staged file at path."""
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        return False, "nothing staged", None
    if not os.path.isfile(path) or os.path.islink(path) or st.st_uid != os.getuid() or st.st_mode & 0o022:
        return False, "staged file isn't private", None
    try:
        move = json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return False, "staged file unreadable", None
    if not isinstance(move, dict):
        return False, "staged file unreadable", None
    url, conf, thr, exp = move.get("url"), move.get("confidence"), move.get("threshold"), move.get("expires")
    if not isinstance(url, str) or not url.startswith(("http://", "https://")):
        return False, "not a web address", move
    if isinstance(exp, (int, float)) and exp <= now_ms:
        return False, "expired", move
    thr = min(max(float(thr), 0.5), 1.0) if isinstance(thr, (int, float)) else 0.85
    if not isinstance(conf, (int, float)) or conf < thr:
        return False, f"confidence {conf} below {thr}", move
    return True, "ok", move


def main():
    dry = "--dry-run" in sys.argv[1:]
    folder = runtime_dir()
    now = int(time.time() * 1000)
    fire, why, move = decide(folder / "next_move.json", now)
    if dry:
        print(json.dumps({"fire": fire, "why": why, "move": (move or {}).get("move"), "url": (move or {}).get("url")}))
        return 0
    if not fire:
        return 0
    subprocess.Popen(["xdg-open", move["url"]], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)
    fd = os.open(folder / "fired.jsonl", os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    with os.fdopen(fd, "a") as f:
        f.write(json.dumps({"move": str(move.get("move") or ""), "t": now}) + "\n")
    try:
        (folder / "next_move.json").unlink()  # used up: pressing again doesn't reopen it
    except FileNotFoundError:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
